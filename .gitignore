# ---------------------------------------------------------------------------
# Secrets & credentials -- never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*license_key*
*.key
*.pem
secrets.*
credentials.*

# ---------------------------------------------------------------------------
# Research data & pipeline outputs
# Imaging data is large and may be unpublished. Keep it outside the repo or
# fetch it from Zenodo. Small fixtures for tests live in tests/data/.
# ---------------------------------------------------------------------------
/data/
/results/
/output*/
normalised_data/
pooled_data/
warpmatrix/
*.csv
*.tsv
*.parquet
*.pq
*.h5ad
*.h5
*.hdf5
*.imzML
*.imzml
*.ibd
*.slx
*.nii
*.nii.gz
*.npy
*.npz
*.zarr/
*.tif
*.tiff
*.qs
!tests/data/**

# Pickles can execute code on load and tend to hold scratch state
*.pkl
*.pickle

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
__pypackages__/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/

# Docs build
docs/_build/
site/

# ---------------------------------------------------------------------------
# R (rpy2 / MetaboAnalystR side effects)
# ---------------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
*.rds
*.rda
R_output.txt

# ---------------------------------------------------------------------------
# Logs & scratch
# ---------------------------------------------------------------------------
logs/
*.log
debug/
scratch/
tmp/

# ---------------------------------------------------------------------------
# OS & editor junk
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
